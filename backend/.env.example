# ==============================================================================
# 🚀 365MEO - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the same directory and fill in your credentials.
#

# ------------------------------------------------------------------------------
# 🌐 1. Server & General Settings
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# The URL of your frontend application (used for generating magic login links in alerts)
FRONTEND_URL=https://365meo-dev.vercel.app

# Secure key for triggering automated batch processing (Cron scheduler)
# Ensure this matches the Bearer token sent by your cron job scheduler (e.g. Render/GitHub Actions)
CRON_SECRET=your_super_secure_cron_secret_here

# ------------------------------------------------------------------------------
# 💾 2. Database Connection
# ------------------------------------------------------------------------------
# PostgreSQL database URL (e.g., from Render PostgreSQL or Supabase)
DATABASE_URL="postgresql://username:password@hostname:port/database_name?sslmode=require"

# ------------------------------------------------------------------------------
# 🤖 3. AI Settings (Google Gemini API)
# ------------------------------------------------------------------------------
# API Key for Google AI Studio (Gemini 1.5 Flash / Pro)
# Used for generating automated post content and smart replies to reviews.
GEMINI_API_KEY="AIzaSyYourGeminiAPIKeyHere..."

# ------------------------------------------------------------------------------
# 🔑 4. Google Cloud Platform (GCP) & API Integration
# ------------------------------------------------------------------------------
# Client ID and Secret obtained from GCP Console (OAuth 2.0 Credentials)
# Enabled APIs must include: Google Business Profile API, Google Drive API
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# OAuth 2.0 Redirect URI (registered in your GCP Credentials)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Permanent refresh token obtained via the OAuth 2.0 flow
# Enables background, unattended sync and posting 24/7.
GOOGLE_REFRESH_TOKEN="1//your_google_refresh_token_here..."

# ------------------------------------------------------------------------------
# 💬 5. LINE Developers Integration (Messaging API)
# ------------------------------------------------------------------------------
# Channel details from your LINE Developers console provider
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here..."
LINE_CHANNEL_SECRET="your_line_channel_secret_here"

# Optional: The LINE User ID of the primary administrator for automatic start-up health checks
LINE_USER_ID="Uyour_line_user_id_here..."
